# Server Configuration
PORT=8000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/mppolice

# JWT Authentication
JWT_SECRET=mp_police_super_secure_jwt_secret_key_2026_!@#$%^
JWT_EXPIRES_IN=7d

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Brevo (Sendinblue) Nodemailer SMTP Configuration
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_login_email@domain.com
BREVO_SMTP_PASS=your_brevo_smtp_key_here
BREVO_FROM_EMAIL=no-reply@mppolice.gov.in
BREVO_FROM_NAME="MP Police Dial 112 Portal"

# Initial Admin Credentials (for seed script)
ADMIN_EMAIL=admin@mppolice.gov.in
ADMIN_PASSWORD=PoliceAdmin@2026!
ADMIN_NAME=Senior Admin Officer
ADMIN_BADGE=MP-DIAL112-001
