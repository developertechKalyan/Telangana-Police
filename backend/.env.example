# Server Configuration
PORT=8000
NODE_ENV=development
# Website origin(s) allowed to call the API, comma-separated (e.g. https://dial112.example.gov.in)
CLIENT_URL=http://localhost:5173
# Number of proxies in front of the API in production (usually 1). 0 when running locally.
TRUST_PROXY=0

# MongoDB Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/mppolice

# JWT Authentication
# Required. Long random value, unique per server. Generate with:  openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Brevo (Sendinblue) Nodemailer SMTP Configuration
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_login_email@domain.com
BREVO_SMTP_PASS=your_brevo_smtp_key_here
BREVO_FROM_EMAIL=no-reply@tspolice.gov.in
BREVO_FROM_NAME="Telangana Police Dial 112 Portal"

# Initial Admin Credentials (for seed script)
ADMIN_EMAIL=admin@tspolice.gov.in
# Used only by `npm run seed:admin`. 12+ chars with upper, lower and a number. Remove after first login.
ADMIN_PASSWORD=
ADMIN_NAME=Senior Admin Officer
ADMIN_BADGE=TG-DIAL112-001

# Optional: live weather station (defaults to TGiCCC, Hyderabad). Data from Open-Meteo, no key needed.
# WEATHER_LAT=17.4147275
# WEATHER_LON=78.427625
# WEATHER_LOCATION="TGiCCC — Telangana Integrated Command and Control Centre, Hyderabad"
# WEATHER_REFRESH_MINUTES=5
