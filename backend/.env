# Server Configuration
PORT=8000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Database Connection (Change to your MongoDB Atlas or Local URI)
MONGODB_URI=mongodb://127.0.0.1:27017/mppolice

# JWT Authentication
JWT_SECRET=mp_police_super_secure_jwt_secret_key_2026_!@#$%^
JWT_EXPIRES_IN=7d

# Cloudinary Storage Configuration (Provide your credentials from Cloudinary Dashboard)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Brevo (Sendinblue) Nodemailer SMTP Configuration
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
BREVO_FROM_EMAIL=no-reply@mppolice.gov.in
BREVO_FROM_NAME="MP Police Dial 112 Portal"

# Initial Admin Credentials (for seed script)
ADMIN_EMAIL=admin@mppolice.gov.in
ADMIN_PASSWORD=PoliceAdmin@2026!
ADMIN_NAME=Senior Admin Officer
